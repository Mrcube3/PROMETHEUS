# PROMETHEUS configuration. Every value is optional; defaults run with no secrets.

# --- market ---------------------------------------------------------------
PROM_ASSETS=BTCUSDT,ETHUSDT,SOLUSDT
PROM_HORIZONS=10M,15M
PROM_BINANCE_HOSTS=https://api.binance.com,https://data-api.binance.vision

# --- model ----------------------------------------------------------------
# heuristic (default, deterministic rule engine, NOT an LLM) | anthropic | ollama
PROM_MODEL_PROVIDER=heuristic
# PROM_MODEL_NAME=claude-sonnet-5
# ANTHROPIC_API_KEY=
# PROM_OLLAMA_HOST=http://127.0.0.1:11434

# --- pricing --------------------------------------------------------------
PROM_BASE_PRICE=0.25
PROM_MIN_PRICE=0.05
PROM_MAX_PRICE=5.00
PROM_MIN_REPUTATION_SAMPLE=20

# --- Binance Agent OS (binance-cli) ---------------------------------------
# Read-only corroboration surface. Every generated snapshot is cross-checked
# against the official Binance CLI before it is hashed. No credential is read
# or passed; only the unauthenticated `spot ticker-price` command is issued.
PROM_AGENTOS_ENABLED=1
PROM_AGENTOS_TOLERANCE_BPS=50
# DISPUTED snapshots are refused. UNAVAILABLE (no second witness) never blocks.
PROM_AGENTOS_REQUIRE_AGREEMENT=1

# Native install (Linux/macOS), once `binance-cli` is on PATH:
PROM_AGENTOS_BINARY=binance-cli

# Windows: upstream ships no Windows build, so reach the official Linux binary
# through WSL. Set the distro name and the Linux path to the binary:
# PROM_AGENTOS_WSL_DISTRO=Debian
# PROM_AGENTOS_BINARY=/root/.cargo/bin/binance-cli

# --- settlement -----------------------------------------------------------
# signature_only : SIMULATION. Real EIP-712 recovery, but NO funds move.
# onchain        : real BSC settlement, verified by reading the chain.
# facilitator    : delegate to an x402 facilitator.
PROM_SETTLEMENT_VERIFIER=signature_only

# Required when PROM_SETTLEMENT_VERIFIER=onchain. The server refuses to start
# without it, because verifying against the zero address would report settlement
# that never happened.
# PROM_X402_PAY_TO=0xYourReceiveAddress

PROM_X402_NETWORK=bsc-testnet
PROM_X402_CHAIN_ID=97
PROM_EVM_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
PROM_REQUIRED_CONFIRMATIONS=1
# PROM_X402_FACILITATOR_URL=

# --- runtime --------------------------------------------------------------
PROM_AUTOPILOT=1
PROM_GENERATE_INTERVAL_S=120
PROM_RESOLVE_INTERVAL_S=30
PROM_HOST=127.0.0.1
PROM_PORT=8402
